<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("./partials/head.ejs") %>  
    <title>My Blogs</title>
</head>
<body>
    <%- include("./partials/nav.ejs") %>  
    
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0">My Blogs</h2>
            <% if (all_my_Blogs && all_my_Blogs.length > 0) { %>
                <a href="/blog/add-new" class="btn btn-primary d-inline-flex align-items-center gap-1">
                    <i class="bi bi-plus-lg"></i> Add New Blog
                </a>
            <% } %>
        </div>

        <% if (!all_my_Blogs || all_my_Blogs.length === 0) { %>
            <div class="card p-5 text-center bg-body-tertiary border shadow-sm my-5">
                <div class="mb-3">
                    <i class="bi bi-journal-plus display-1 text-secondary opacity-75"></i>
                </div>
                <h4 class="fw-bold mb-2">You haven't written any blogs yet</h4>
                <p class="text-muted mb-4 fs-5">
                    Please start by adding a blog to share your thoughts and stories!
                </p>
                <div>
                    <a href="/blog/add-new" class="btn btn-primary btn-lg px-4 d-inline-flex align-items-center gap-2 shadow-sm">
                        <i class="bi bi-plus-circle"></i> Add Your First Blog
                    </a>
                </div>
            </div>
        <% } else { %>
            <div class="row">
                <% all_my_Blogs.forEach(blog => { %>
                    <div class="col-md-4 mb-4">
                        <div class="card h-100 shadow-sm border">
                            <% if (blog.coverImage) { %>
                                <img src="<%= blog.coverImage %>" class="card-img-top" alt="<%= blog.title %>" style="height: 200px; object-fit: cover;">
                            <% } %>

                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title fw-bold"><%= blog.title %></h5>

                                <div class="mt-auto d-flex gap-2 pt-3">
                                    <a href="/blog/<%= blog._id %>" class="btn btn-outline-primary flex-grow-1 d-inline-flex align-items-center justify-content-center gap-1">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                    <a href="/blog/<%= blog._id %>/edit" class="btn btn-primary flex-grow-1 d-inline-flex align-items-center justify-content-center gap-1">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>

    <%- include("./partials/script.ejs") %>  
</body>
</html>