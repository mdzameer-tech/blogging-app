<!DOCTYPE html>
<html lang="en">
<head>
     <%- include("./partials/head.ejs") %>  
    <title>HOME PAGE </title>
</head>
<body>
    <%- include("./partials/nav.ejs") %>  
    
    <div class="container mt-4">
        <div class="row">
            <% blogs.forEach(blog => { %>
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <% if (blog.coverImage) { %>
                            <img src="<%= blog.coverImage %>" class="card-img-top" alt="<%= blog.title %>" style="height: 200px; object-fit: cover;" onerror="this.src='/image/default-image.jpg'">
                        <% } else { %>
                            <img src="/image/default-image.jpg" class="card-img-top" alt="<%= blog.title %>" style="height: 200px; object-fit: cover;">
                        <% } %>

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title"><%= blog.title %></h5>

                            <a href="/blog/<%= blog._id %>" class="btn btn-primary mt-auto">
                                View
                            </a>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>

    <%- include("./partials/script.ejs") %>  
</body>
</html>