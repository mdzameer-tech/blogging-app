
<!DOCTYPE html>
<html lang="en">
<head>
     <%- include("./partials/head.ejs") %>  
    <title>Blog</title>
</head>
<body>
    <%- include("./partials/nav.ejs") %>  
    <div class="container mt-4">
        <h1><%= blog.title %></h1>
        <% if (blog.coverImage) { %>
          <img src="<%= blog.coverImage %>" class="img-fluid rounded shadow-sm my-3" style="max-height: 450px; width: 100%; object-fit: cover;" alt="<%= blog.title %>"/>
        <% } %>
        <div class="mt-3 p-3 bg-body-tertiary border rounded" style="white-space: pre-wrap; font-size: 16px; line-height: 1.7;"><%= blog.body %></div>

        <% if (locals.user && blog.createdBy && (String(blog.createdBy._id) === user._id ||
                (blog.collaborators && blog.collaborators.some(c => String(c._id) === user._id)))) { %>
          <div class="mt-3">
            <a href="/blog/<%= blog._id %>/edit" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1">
              <i class="bi bi-pencil-square"></i> Edit live
            </a>
          </div>
        <% } %>
    </div>
 
    <% if (blog.createdBy) { %>
    <div class="container mt-4">
      <p>Creator</p>
      <img src="<%= blog.createdBy.profileImage %>" width="40px"/> <%= 
        blog.createdBy.firstName %> <%= blog.createdBy.lastName %>
    </div>
    <% } %>

    <% if (blog.collaborators && blog.collaborators.length > 0) { %>
    <div class="container mt-3">
      <p>Collaborators</p>
      <% blog.collaborators.forEach(collab => { %>
        <div class="mb-2">
          <img src="<%= collab.profileImage %>" width="40px"/> 
          <%= collab.firstName %> <%= collab.lastName %>
        </div>
      <% }) %>
    </div>
    <% } %>

    <% if (locals.user && blog.createdBy && String(blog.createdBy._id) === user._id) { %>
    <div class="container mt-3">
      <form action="/blog/<%= blog._id %>/collaborators" method="post" class="d-flex align-items-end gap-2">
        <div>
          <label class="form-label mb-1">Add collaborator (email)</label>
          <input type="email" name="email" class="form-control" required />
        </div>
        <button class="btn btn-sm btn-primary">Add</button>
      </form>
    </div>
    <% } %>

    <div class="container mt-3">
      <h4>Comments (<%= comments.length %>)</h4>
      <% if (locals.user) { %>
      <form action="/blog/comment/<%= blog._id %>" method="post">
        <div class="mb-3">
          <input
            type="text"
            name="content"
            class="form-control"
            placeholder="Enter your comment"
          />
          <button class="btn btn-sm btn-primary mt-2" type="submit">Add</button>
        </div>
      </form>
      <% } %>

      <div class="mt-3">
        <% comments.forEach(comment => { %>
        <div class="mb-2">
          <% if (comment.createdBy) { %>
            <img src="<%= comment.createdBy.profileImage %>" width="40px" />
            <%= comment.createdBy.firstName %> <%= comment.createdBy.lastName %>
          <% } %>
          <pre><%= comment.content %></pre>
        </div>
        <% }) %>
      </div>
    </div>

    <%- include("./partials/script.ejs") %>  
</body>
</html>