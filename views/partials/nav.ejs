<nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom">
  <div class="container-fluid">
    <a class="navbar-brand fw-bold" href="/">Bloggify</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavDropdown">
      <ul class="navbar-nav me-auto">
        <li class="nav-item">
          <a class="nav-link active" aria-current="page" href="/">Home</a>
        </li>
        <% if (locals.user) { %>
          <li class="nav-item">
            <a class="nav-link" href="/blog/add-new">Add Blog</a>
          </li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <% if (locals.user.profileImage) { %>
                <img src="<%= locals.user.profileImage %>" width="30" height="30" class="rounded-circle object-fit-cover shadow-sm border border-2 border-primary-subtle" style="aspect-ratio: 1/1;" alt="Avatar" onerror="this.src='/image/default-image.jpg'" />
              <% } else { %>
                <i class="bi bi-person-circle fs-5"></i>
              <% } %>
              <span><%- locals.user.firstName %></span>
            </a>

            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
              <li>
                <a class="dropdown-item d-flex align-items-center gap-2" href="/user/profile">
                  <i class="bi bi-person"></i> My Profile
                </a>
              </li>
              <li>
                <a class="dropdown-item d-flex align-items-center gap-2" href="/blog/my-blogs">
                  <i class="bi bi-journal-text"></i> My Blogs
                </a>
              </li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <a class="dropdown-item text-danger d-flex align-items-center gap-2" href="/user/logout">
                  <i class="bi bi-box-arrow-right"></i> Logout
                </a>
              </li>
            </ul>
          </li>
        <% } else { %>
          <li class="nav-item">
            <a class="nav-link" href="/user/signup">Create Account</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/user/signin">Signin</a>
          </li>
        <% } %>
      </ul>

      <!-- Theme Switcher Button for Light and Dark mode -->
      <div class="d-flex align-items-center ms-lg-3 my-2 my-lg-0">
        <button id="themeToggleBtn" class="btn btn-outline-secondary btn-sm theme-toggle-btn d-flex align-items-center gap-2 px-3 py-1 shadow-sm" type="button" aria-label="Toggle light and dark mode">
          <i id="themeToggleIcon" class="bi bi-moon-stars-fill"></i>
          <span id="themeToggleLabel" class="small fw-semibold">Dark</span>
        </button>
      </div>
    </div>
  </div>
</nav>

<% if (locals.error) { %>
  <div class="container mt-4">
    <div class="alert alert-danger" role="alert"> 
      <%= locals.error %>
    </div>
  </div>
<% } %>